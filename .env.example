# Copy to .env and adjust. docker-compose.yml already sets sane defaults,
# so you only need this file when running the API outside Docker.

# postgres or memory. "memory" keeps everything in process and needs no database.
STORE_BACKEND=postgres
DATABASE_URL=postgresql://rag:rag@localhost:5432/rag

# redis or memory
CACHE_BACKEND=redis
REDIS_URL=redis://localhost:6379/0

# openai or fake. "fake" uses deterministic hash embeddings and a template
# answer, so it needs no API key and no network.
PROVIDER=fake
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini
EMBEDDING_DIM=1536

CHUNK_TARGET_CHARS=900
CHUNK_OVERLAP_CHARS=150
DEFAULT_TOP_K=5
ANSWER_CACHE_TTL_SECONDS=3600
EMBEDDING_CACHE_TTL_SECONDS=604800
